{
    "java.compile.nullAnalysis.mode": "automatic",
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/.gradle/**": true,
        "**/build/**": true,
        "**/.venv/**": true,
        "**/venv/**": true,
        "**/env/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/.gradle": true,
        "**/build": true,
        "**/.venv": true,
        "**/venv": true,
        "**/env": true
    }
}